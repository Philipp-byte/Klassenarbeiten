        { "id": "t_test13d", "name": "E-Mail-Link (mailto)", "punkte": 1, "art": "attribut", "selektor": "a", "attribut": "href", "erwartet": "mailto:", "exakt": false },
        { "id": "t_test13e", "name": "Überschrift in Navy", "punkte": 1, "art": "stil", "selektor": "h1", "eigenschaft": "color", "erwartet": "rgb(0, 52, 77)" }
