    {
      "id": "a_test11py",
      "titel": "Funktion für die Fahrtkosten",
      "text": "Schreibe die Funktion `fahrtkosten(tage, personen)`.\n\nSie berechnet den Anteil **einer** Person in Euro:\n- Ein Fahrtag sind 54 km, ein Kilometer kostet 0,30 €.\n- Die Tageskosten werden durch die Anzahl der Personen geteilt.\n- Das Ergebnis wird mit `round` auf zwei Nachkommastellen gerundet zurückgegeben.",
      "abschnitt": "Programmieren",
      "situationsAnschluss": "Jetzt schreibst du den Teil des Programms, der die Kosten berechnet.",
      "handlungsschritt": "durchfuehren",
      "punkte": 0,
      "typ": "code-python",
      "startcode": "def fahrtkosten(tage, personen):\n    # Deine Lösung hier\n    pass\n",
      "loesungscode": "def fahrtkosten(tage, personen):\n    kosten = tage * 54 * 0.30 / personen\n    return round(kosten, 2)\n",
      "vorlaufcode": "",
      "tests": [
        { "id": "t_test11a", "name": "15 Tage, 4 Personen → 60,75 €", "punkte": 3, "art": "funktion", "funktion": "fahrtkosten", "argumente": "15, 4", "erwartet": "60.75", "toleranz": 0.001 },
        { "id": "t_test11b", "name": "0 Tage kosten nichts", "punkte": 1, "art": "funktion", "funktion": "fahrtkosten", "argumente": "0, 4", "erwartet": "0", "toleranz": 0.001 },
        { "id": "t_test11c", "name": "20 Tage, 3 Personen → 108,00 €", "punkte": 2, "art": "assert", "code": "assert abs(fahrtkosten(20, 3) - 108.0) < 0.01, 'fahrtkosten(20, 3) muss 108.0 ergeben'" },
        { "id": "t_test11d", "name": "Es wird mit round gerundet", "punkte": 2, "art": "enthaelt", "muster": "round", "vorhanden": true }
      ],
      "selbsttests": [
        { "id": "t_test11s1", "name": "Die Funktion ist vorhanden", "punkte": 0, "art": "assert", "code": "assert callable(fahrtkosten), 'Es gibt keine Funktion fahrtkosten'" },
        { "id": "t_test11s2", "name": "10 Tage, 4 Personen → 40,50 €", "punkte": 0, "art": "funktion", "funktion": "fahrtkosten", "argumente": "10, 4", "erwartet": "40.5", "toleranz": 0.001 }
      ]
    },
