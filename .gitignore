# ---------------------------------------------------------------------------
# Pyodide wird lokal geholt (ca. 12 MB) und gehört nicht ins Repository.
# Auf der veröffentlichten SuS-Website legt es der Veröffentlichungs-Workflow ab.
# ---------------------------------------------------------------------------
app/vendor/pyodide/
!app/vendor/pyodide/.gitkeep

# ---------------------------------------------------------------------------
# NIEMALS einchecken – enthält Lösungen bzw. personenbezogene Daten.
# ---------------------------------------------------------------------------
*.jjwsa          # verschlüsselte Abgaben der SuS
*.jjwskey        # privater Schlüssel der Lehrkraft
*.jjwsm          # Klassenarbeiten mit Lösungen …
!beispiele/*.jjwsm   # … außer der Beispielarbeit mit erfundenen Inhalten
*.jjwsp          # ausgegebene Fassungen

abgaben/
korrekturen/
notenlisten/
*.csv
!beispiele/*.csv

# ---------------------------------------------------------------------------
# Sonstiges
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
node_modules/
_site/
